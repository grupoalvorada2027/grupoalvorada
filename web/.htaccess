# Painel de lucratividade - Apache (HostGator).
#
# A protecao de acesso e feita pelo login em PHP (login.php + auth.php), nao
# pelo "Privacidade de Diretorio" do cPanel: o login proprio tem niveis de
# acesso, botao de sair e bloqueio por tentativas, que o HTTP Basic nao tem.
#
# ATENCAO: se voce ativar a Privacidade de Diretorio no cPanel, ele grava as
# diretivas de autenticacao NESTE arquivo - e a proxima publicacao por FTP as
# apaga sem avisar. Use uma coisa ou outra, nunca as duas.

# ---------------------------------------------------------------
# HTTPS obrigatorio. O painel expoe custo e margem.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ===============================================================
# BLOQUEIOS
#
# Escrito para Apache 2.4 (Require) e 2.2 (Order/Deny) ao mesmo tempo, porque
# uma diretiva desconhecida pelo servidor derruba o site inteiro com erro 500.
# ===============================================================

# ---------------------------------------------------------------
# O dados.json contem custo e margem de toda a operacao.
#
# Bloqueado para acesso direto. Quem entrega e o dados.php, que confere a
# sessao e remove os campos sensiveis conforme o papel do usuario. Sem este
# bloqueio o login seria decorativo: bastaria abrir /dados.json no navegador.
#
# O dados.php le o arquivo pelo sistema de arquivos, entao nao e afetado.
# ---------------------------------------------------------------
<FilesMatch "\.json$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# config.php guarda os hashes das senhas e a chave da ponte OAuth.
#
# O PHP normalmente o executa e devolve corpo vazio, sem revelar nada. Mas se o
# interpretador falhar ou for desativado, o Apache serviria o arquivo como texto
# e entregaria os segredos. Bloqueamos o acesso direto; o require_once do PHP
# nao passa pelo servidor web, entao continua funcionando.
# ---------------------------------------------------------------
<FilesMatch "^config(\.exemplo)?\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# Arquivos ocultos: troca do OAuth, controle de tentativas, etc.
# ---------------------------------------------------------------
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------------------------------------------------------------
# Sem listagem de diretorio.
# ---------------------------------------------------------------
Options -Indexes

# ---------------------------------------------------------------
# Cabecalhos
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  # CSS e JS sempre revalidados. Com cache de horas, o celular continuava
  # usando a versão antiga do painel depois de uma atualização, sem aviso.
  # "no-cache" não baixa de novo à toa: só confere se mudou.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Política de conteúdo: o navegador só executa script vindo deste próprio
  # site, e nunca script embutido no HTML. Se um dia alguém conseguir injetar
  # código numa página, o navegador se recusa a rodá-lo. Também proíbe enviar
  # dados para qualquer outro endereço (connect-src) e embutir o painel em
  # outro site (frame-ancestors).
  # style 'unsafe-inline' fica liberado porque as barras dos gráficos usam
  # largura e cor calculadas no atributo style; estilo não executa código.
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"

  # HTTPS obrigatório também na memória do navegador: depois da primeira
  # visita, ele nem tenta abrir o painel por HTTP, onde poderia ser
  # interceptado numa rede Wi-Fi pública.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  # O endereço do painel não vai para nenhum outro site ao clicar num link.
  Header always set Referrer-Policy "no-referrer"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header unset X-Powered-By
</IfModule>

# Pedaços de página (prefixo "_") e temporários de gravação não são páginas.
<FilesMatch "^_|\.tmp$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

DirectoryIndex index.php
