{
  "name": "grupo-alvorada-bi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Analise de lucratividade por canal de venda a partir do ERP Bling",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "npm run generate -w @alvorada/db",
    "db:migrate": "npm run migrate -w @alvorada/db",
    "db:studio": "npm run studio -w @alvorada/db",
    "db:seed": "npm run seed -w @alvorada/db",
    "api": "npm run dev -w @alvorada/api",
    "worker": "npm run dev -w @alvorada/worker",
    "backfill": "npm run backfill -w @alvorada/worker",
    "test": "npm run test -w @alvorada/shared && npm run test -w @alvorada/bling",
    "doutor": "node scripts/doutor.mjs",
    "painel": "node scripts/servir-local.mjs",
    "publicar:interface": "node scripts/publicar-interface.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
