# ============================================================
# Grupo Alvorada BI - variaveis de ambiente
# Copie para .env e preencha. O .env NUNCA vai para o Git.
# ============================================================

# --- Banco de dados (PostgreSQL no servidor Windows) --------
# Em producao o host e localhost, porque a API roda na mesma maquina do banco.
DATABASE_URL="postgresql://alvorada:TROQUE_ESTA_SENHA@localhost:5432/alvorada_bi?schema=public"

# --- Aplicativo Bling (Central de Extensoes > Area do Integrador) ---
# O client_secret tambem assina os webhooks (HMAC SHA-256). Trate como senha.
BLING_CLIENT_ID=""
BLING_CLIENT_SECRET=""
# Precisa ser IDENTICA a URL cadastrada no app Bling, inclusive sem barra no final.
BLING_REDIRECT_URI="https://api.seudominio.com.br/oauth/callback"

# Limite real do Bling e 3 req/s. Usamos 2.5 como margem de seguranca:
# estourar o limite pode banir o IP por 10 minutos.
BLING_RATE_LIMIT_PER_SECOND="2.5"

# --- API ----------------------------------------------------
API_PORT="3333"
API_HOST="127.0.0.1"
NODE_ENV="development"
LOG_LEVEL="info"

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Origens liberadas no CORS (o front na HostGator). Separe por virgula.
CORS_ORIGINS="http://localhost:5173,https://app.seudominio.com.br"

# --- Worker -------------------------------------------------
# Quantos meses de historico o backfill inicial importa.
BACKFILL_MESES="3"
# Intervalo do sync incremental (rede de seguranca p/ webhook perdido).
SYNC_CRON="*/15 * * * *"
# Checagem da validade do refresh_token (expira em 30 dias).
TOKEN_REFRESH_CRON="0 */4 * * *"

# --- Usuario administrador inicial (usado pelo seed) --------
ADMIN_EMAIL="admin@seudominio.com.br"
ADMIN_SENHA=""
ADMIN_NOME="Administrador"

# --- Publicacao do painel na HostGator (FTP) -----------------
# O servidor ENVIA os resultados para a hospedagem. Conexoes de saida apenas:
# nada precisa ser aberto no roteador.
FTP_HOST="ftp.seudominio.com.br"
FTP_USER=""
FTP_SENHA=""
FTP_DIR="/"
FTP_SEGURO="true"
PUBLICAR_CRON="*/30 * * * *"
ANALISE_MESES="12"

# --- Ponte de autorizacao OAuth ------------------------------
# URL do oauth-callback.php publicado na hospedagem e o segredo compartilhado.
# A chave tem de ser IDENTICA a constante PONTE_CHAVE dentro do PHP.
OAUTH_PONTE_URL="https://seudominio.com.br/painel/oauth-callback.php"
OAUTH_PONTE_CHAVE=""

# --- Mercado Pago -------------------------------------------------------------
# Uma credencial por conta do Mercado Pago. Cada conta do Mercado Livre tem a
# sua: use o apelido no nome da variavel. Fica SO no servidor, nunca no web/.
# Credencial de producao comeca com APP_USR-. Ver docs/mercado-pago.md.
MP_ACCESS_TOKEN_DIST=
MP_ACCESS_TOKEN_TOMAX=
MP_ACCESS_TOKEN_TMZ=
